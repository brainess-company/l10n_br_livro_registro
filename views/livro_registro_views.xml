<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_livro_registro_form" model="ir.ui.view">
        <field name="name">livro.registro.form</field>
        <field name="model">livro.registro.relatorio</field>
        <field name="arch" type="xml">
            <form string="Gerar Livro Registro">
                <group>
                    <field name="tipo_livro" required="1"/>
                    <field name="data_inicio" required="1"/>
                    <field name="data_fim" required="1"/>
                    <field name="company_id" required="1"/>
                </group>
                <footer>
                    <button string="Gerar PDF" type="object" name="gerar_relatorio" context="{'format': 'pdf'}" class="btn-primary"/>
                    <button string="Gerar XLSX" type="object" name="gerar_relatorio" context="{'format': 'xlsx'}" class="btn-secondary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Criando a ação vinculada ao formulário -->
    <record id="action_livro_registro_form" model="ir.actions.act_window">
        <field name="name">Gerar Livro Registro</field>
        <field name="res_model">livro.registro.relatorio</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_livro_registro_form"/>
    </record>

    <!-- Herdando a navbar do módulo fiscal brasileiro -->
    <menuitem id="menu_fiscal_relatorios"
              name="Relatórios CFOP"
              parent="l10n_br_fiscal.fiscal_menu"
              action="action_livro_registro_form"
              sequence="1000"/>


</odoo>

